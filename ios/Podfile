require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'

platform :ios, '12.0'
source 'https://github.com/CocoaPods/Specs.git'

target 'CalendarsExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # to enable hermes on iOS, change `false` to `true` and then install pods
    :hermes_enabled => true
  )

  target 'CalendarsExampleTests' do
    inherit! :search_paths
    # Pods for testing
  end

  post_install do |installer|
    react_native_post_install(installer)
    __apply_Xcode_12_5_M1_post_install_workaround(installer)

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Xcode 15+ no longer supports deployment targets below 12.0
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 12.0
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
        end

        defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
        defs = [defs] unless defs.is_a?(Array)

        # Folly's Time.h redefines clockid_t, which conflicts with modern iOS SDKs.
        if target.name == 'RCT-Folly' && !defs.any? { |d| d.to_s.include?('FOLLY_HAVE_CLOCK_GETTIME') }
          defs << 'FOLLY_HAVE_CLOCK_GETTIME=1'
        end

        # Boost/hash uses std::unary_function, removed in newer libc++ (Xcode 15+)
        unless defs.any? { |d| d.to_s.include?('_LIBCPP_ENABLE_CXX17_REMOVED_UNARY_BINARY_FUNCTION') }
          defs << '_LIBCPP_ENABLE_CXX17_REMOVED_UNARY_BINARY_FUNCTION'
        end

        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs

        # RN 0.66 Yoga/Boost trigger new Clang warnings that are treated as errors
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        existing_flags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || '$(inherited)'
        existing_flags = existing_flags.join(' ') if existing_flags.is_a?(Array)
        unless existing_flags.include?('-Wno-bitwise-instead-of-logical')
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] =
            "#{existing_flags} -Wno-bitwise-instead-of-logical -Wno-unused-but-set-variable"
        end
      end

      # Yoga ships per-file `-Wall -Werror`; those come after OTHER_CPLUSPLUSFLAGS and
      # re-enable -Wbitwise-instead-of-logical on modern Clang. Strip -Werror / append disables.
      if target.name == 'Yoga'
        target.source_build_phase.files.each do |file|
          next unless file.settings && file.settings['COMPILER_FLAGS']

          flags = file.settings['COMPILER_FLAGS'].to_s
          flags = flags.gsub(/\s-Werror\b/, '')
          unless flags.include?('-Wno-bitwise-instead-of-logical')
            flags = "#{flags} -Wno-bitwise-instead-of-logical"
          end
          file.settings['COMPILER_FLAGS'] = flags
        end
      end
    end
  end
end
